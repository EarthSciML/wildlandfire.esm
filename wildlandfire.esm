                                    {
                                      "op": "-",
                                      "args": [
                                        "c",
                                        1
                                      ]
                                    },
                                    5
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    1
                  ]
                }
              ]
            }
          }
        },
        "F_d_h1": {
          "type": "observed",
          "units": "1",
          "shape": [
            "ov5.src_cells"
          ],
          "description": "Bracket record 1 (era5_t index 2) of the 2-record time bracket. F_d (2 m dewpoint): single-time slice reindexed into the src cell-ring order (lon x-fastest, lat flipped N->S), matching TerrainRegrid.F_elev.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "c"
            ],
            "ranges": {
              "c": {
                "from": "ov5.src_cells"
              }
            },
            "args": [
              "F_d"
            ],
            "expr": {
              "op": "index",
              "args": [
                "F_d",
                2,
                {
                  "op": "-",
                  "args": [
                    5,
                    {
                      "op": "floor",
                      "args": [
                        {
                          "op": "/",
                          "args": [
                            {
                              "op": "-",
                              "args": [
                                "c",
                                1
                              ]
                            },
                            5
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "c",
                            1
                          ]
                        },
                        {
                          "op": "*",
                          "args": [
                            5,
                            {
                              "op": "floor",
                              "args": [
                                {
                                  "op": "/",
                                  "args": [
                                    {
                                      "op": "-",
                                      "args": [
                                        "c",
                                        1
                                      ]
                                    },
                                    5
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    1
                  ]
                }
              ]
            }
          }
        },
        "d_regridded0": {
          "type": "observed",
          "units": "1",
          "shape": [
            "ov5.tgt_cells"
          ],
          "description": "Bracket record 0: F_d_h0 conservatively regridded onto the fire cells (ov5 weights).",
          "expression": {
            "op": "apply_expression_template",
            "name": "ov5.conservative_overlap_apply",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "A_j": "A_j",
              "F_src": "F_d_h0",
              "atol": "atol"
            }
          }
        },
        "d_regridded1": {
          "type": "observed",
          "units": "1",
          "shape": [
            "ov5.tgt_cells"
          ],
          "description": "Bracket record 1: F_d_h1 conservatively regridded onto the fire cells (ov5 weights).",
          "expression": {
            "op": "apply_expression_template",
            "name": "ov5.conservative_overlap_apply",
            "args": [],
            "bindings": {
              "A_ij": "A_ij",
              "A_j": "A_j",
              "F_src": "F_d_h1",
              "atol": "atol"
            }
          }
        },
        "d_xy0": {
          "type": "observed",
          "units": "K",
          "shape": [
            "x",
            "y"
          ],
          "description": "Bracket record 0 regridded to [x,y]. Per-cell 2 m dewpoint (K); blended in time into d_xy, then RH derived via Magnus (rh_xy).",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gx",
              "gy"
            ],
            "ranges": {
              "gx": {
                "from": "x"
              },
              "gy": {
                "from": "y"
              }
            },
            "args": [
              "d_regridded0"
            ],
            "expr": {
              "op": "index",
              "args": [
                "d_regridded0",
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "gy",
                            1
                          ]
                        },
                        "NX"
                      ]
                    },
                    "gx"
                  ]
                }
              ]
            }
          }
        },
        "d_xy1": {
          "type": "observed",
          "units": "K",
          "shape": [
            "x",
            "y"
          ],
          "description": "Bracket record 1 regridded to [x,y]. Per-cell 2 m dewpoint (K); blended in time into d_xy, then RH derived via Magnus (rh_xy).",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gx",
              "gy"
            ],
            "ranges": {
              "gx": {
                "from": "x"
              },
              "gy": {
                "from": "y"
              }
            },
            "args": [
              "d_regridded1"
            ],
            "expr": {
              "op": "index",
              "args": [
                "d_regridded1",
                {
                  "op": "+",
                  "args": [
                    {
                      "op": "*",
                      "args": [
                        {
                          "op": "-",
                          "args": [
                            "gy",
                            1
                          ]
                        },
                        "NX"
                      ]
                    },
                    "gx"
                  ]
                }
              ]
            }
          }
        },
        "d_xy": {
          "type": "observed",
          "units": "K",
          "shape": [
            "x",
            "y"
          ],
          "description": "TIME-INTERPOLATED per-cell 2 m dewpoint (K): linear blend of the two bracketing ERA5 records after each is conservatively regridded to the fire grid — (1-w_time)*d_xy0 + w_time*d_xy1. Feeds the Magnus RH (rh_xy) together with t_xy. w_time is coupled from ERA5.w_time.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gx",
              "gy"
            ],
            "ranges": {
              "gx": {
                "from": "x"
              },
              "gy": {
                "from": "y"
              }
            },
            "args": [
              "d_xy0",
              "d_xy1"
            ],
            "expr": {
              "op": "+",
              "args": [
                {
                  "op": "*",
                  "args": [
                    {
                      "op": "-",
                      "args": [
                        1,
                        "w_time"
                      ]
                    },
                    {
                      "op": "index",
                      "args": [
                        "d_xy0",
                        "gx",
                        "gy"
                      ]
                    }
                  ]
                },
                {
                  "op": "*",
                  "args": [
                    "w_time",
                    {
                      "op": "index",
                      "args": [
                        "d_xy1",
                        "gx",
                        "gy"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "rh_xy": {
          "type": "observed",
          "units": "1",
          "shape": [
            "x",
            "y"
          ],
          "description": "Per-cell relative humidity (0-1 fraction) DERIVED from the time-blended ERA5 single-level fields t_xy (2 m T) and d_xy (2 m dewpoint) via Magnus/Tetens RH = e_s(Td)/e_s(T) = exp(A(Td)-A(T)), A(K)=17.62*(K-273.15)/(243.12+(K-273.15)); the 6.112 cancels in the ratio. Because both fields are conservatively regridded and time-blended, Td<=T pointwise (convexity), so the ratio is already in (0,1] with NO clamp needed. Single-level ERA5 carries no RH variable. -> EMC.RH.",
          "expression": {
            "op": "aggregate",
            "output_idx": [
              "gx",
              "gy"
            ],
            "ranges": {
              "gx": {
                "from": "x"
              },
              "gy": {
                "from": "y"
              }
            },
            "args": [
              "t_xy",
              "d_xy"
            ],
            "expr": {
              "op": "exp",
              "args": [
                {
                  "op": "-",
                  "args": [
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            17.62,
                            {
                              "op": "-",
                              "args": [
                                {
                                  "op": "index",
                                  "args": [
                                    "d_xy",
                                    "gx",
                                    "gy"
                                  ]
                                },
                                273.15
                              ]
                            }
                          ]
                        },
                        {
                          "op": "+",
                          "args": [
                            243.12,
                            {
                              "op": "-",
                              "args": [
                                {
                                  "op": "index",
                                  "args": [
                                    "d_xy",
                                    "gx",
                                    "gy"
                                  ]
                                },
                                273.15
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "op": "/",
                      "args": [
                        {
                          "op": "*",
                          "args": [
                            17.62,
                            {
                              "op": "-",
                              "args": [
                                {
                                  "op": "index",
                                  "args": [
                                    "t_xy",
                                    "gx",
                                    "gy"
                                  ]
                                },
                                273.15
                              ]
                            }
                          ]
                        },
                        {
                          "op": "+",
                          "args": [
                            243.12,
                            {
                              "op": "-",
                              "args": [
                                {
                                  "op": "index",
                                  "args": [
                                    "t_xy",
                                    "gx",
                                    "gy"
                                  ]
                                },
                                273.15
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "w_time": {
          "type": "parameter",
          "units": "1",
          "default": 0.0,
          "description": "TIME INTERPOLATION weight in [0,1], coupled from ERA5.w_time (param_to_var). Blends the two bracketing ERA5 records regridded to the fire grid: F_xy = (1-w_time)*F_xy0 + w_time*F_xy1. Continuous in t (ERA5.w_time reads the sim clock), so the met varies smoothly between the hourly ERA5 records instead of the former piecewise-constant hourly step."
        }
      },
      "equations": []
    }
  },
  "coupling": [
    {
      "type": "coupling_import",
      "ref": "../earthscimodels/couplings/wildlandfire_behavior.esm",
      "bind": {
        "Fuel": "FuelModelLookup",
        "EMC": "EquilibriumMoistureContent",
        "FuelMoisture": "OneHourFuelMoisture",
        "Wind": "MidflameWind",
        "Slope": "TerrainSlope",
        "Rothermel": "RothermelFireSpread",
        "LevelSet": "LevelSetFireSpread",
        "Consumption": "FuelConsumption"
      },
      "description": "Rothermel (1972) + NFDRS behavior stack -> level-set leaf, imported by reference from the WildlandFireBehaviorCoupling library (esm-spec 10.9/10.10). Replaces the 21 formerly-inline param_to_var edges wiring FuelModelLookup/EquilibriumMoistureContent/OneHourFuelMoisture/MidflameWind/TerrainSlope -> RothermelFireSpread and RothermelFireSpread/MidflameWind/TerrainSlope -> LevelSetFireSpread (+ FuelModelLookup -> FuelConsumption). Expands at flatten to those same edges (10.10.3), so this assembly flattens identically to the previous inline form. The data-loader/regrid couplings below stay inline because they wire this model's own in-file TerrainRegrid/Era5Regrid regridders."
    },
    {
      "type": "variable_map",
      "from": "USGS3DEP.raw.elevation",
      "to": "TerrainRegrid.F_raw",
      "transform": "param_to_var",
      "description": "USGS 3DEP loader elevation field -> TerrainRegrid.F_raw, the source-grid elevation in the raster's NATIVE [lat,lon] = [src_y, src_x] order. Coupled from the LOADER field raw.elevation (not the USGS3DEP.elevation alias) so build-time geometry setup resolves it against const_arrays: the CONST provider array is folded there by name and F_raw is declared to match its native 2-D shape. ESS is agnostic to dimension order and the EarthSciIO provider extension is a faithful pass-through, so the [lat,lon]->[x,y] reconciliation happens in the model (F_raw -> F_elev transpose), not here."
    },
    {
      "type": "variable_map",
      "from": "TerrainRegrid.dzdx",
      "to": "TerrainSlope.dzdx",
      "transform": "param_to_var",
      "description": "Per-cell terrain dz/dx (regridded elevation, differentiated on the fire grid) -> TerrainSlope; flows to Rothermel tan_phi/aspect and the leaf."
    },
    {
      "type": "variable_map",
      "from": "TerrainRegrid.dzdy",
      "to": "TerrainSlope.dzdy",
      "transform": "param_to_var",
      "description": "Per-cell terrain dz/dy -> TerrainSlope."
    },
    {
      "type": "variable_map",
      "from": "LANDFIRE.raw.fuel_model",
      "to": "TerrainRegrid.F_fuel_raw",
      "transform": "param_to_var",
      "description": "LANDFIRE fuel-model loader field -> TerrainRegrid.F_fuel_raw; regridded like elevation."
    },
    {
      "type": "variable_map",
      "from": "TerrainRegrid.fuel_xy",
      "to": "FuelModelLookup.code",
      "transform": "param_to_var",
      "description": "Per-cell regridded fuel code -> FuelModelLookup.code (promotes sigma/w0/delta/Mx/h to per-cell)."
    },
    {
      "type": "variable_map",
      "from": "ERA5.sl.t2m",
      "to": "Era5Regrid.F_t",
      "transform": "param_to_var",
      "description": "ERA5 single-level 2 m temperature loader field -> Era5Regrid.F_t."
    },
    {
      "type": "variable_map",
      "from": "ERA5.sl.u10",
      "to": "Era5Regrid.F_u",
      "transform": "param_to_var",
      "description": "ERA5 single-level 10 m zonal wind -> Era5Regrid.F_u."
    },
    {
      "type": "variable_map",
      "from": "ERA5.sl.v10",
      "to": "Era5Regrid.F_v",
      "transform": "param_to_var",
      "description": "ERA5 single-level 10 m meridional wind -> Era5Regrid.F_v."
    },
    {
      "type": "variable_map",
      "from": "ERA5.sl.d2m",
      "to": "Era5Regrid.F_d",
      "transform": "param_to_var",
      "description": "ERA5 single-level 2 m dewpoint -> Era5Regrid.F_d (RH derived via Magnus)."
    },
    {
      "type": "variable_map",
      "from": "Era5Regrid.t_xy",
      "to": "EquilibriumMoistureContent.TEMP",
      "transform": "param_to_var",
      "description": "Per-cell ERA5 temperature -> EMC.TEMP."
    },
    {
      "type": "variable_map",
      "from": "Era5Regrid.rh_xy",
      "to": "EquilibriumMoistureContent.RH",
      "transform": "param_to_var",
      "description": "Per-cell ERA5 relative humidity (fraction) -> EMC.RH."
    },
    {
      "type": "variable_map",
      "from": "Era5Regrid.u_xy",
      "to": "MidflameWind.u_wind",
      "transform": "param_to_var",
      "description": "Per-cell ERA5 east wind -> MidflameWind.u_wind."
    },
    {
      "type": "variable_map",
      "from": "Era5Regrid.v_xy",
      "to": "MidflameWind.v_wind",
      "transform": "param_to_var",
      "description": "Per-cell ERA5 north wind -> MidflameWind.v_wind."
    },
    {
      "type": "variable_map",
      "from": "ERA5.w_time",
      "to": "Era5Regrid.w_time",
      "transform": "param_to_var",
      "description": "Time-interpolation weight from the shared ERA5 component -> Era5Regrid's two-record blend. ERA5.w_time = clamp((t - t0_bracket)/(t1_bracket - t0_bracket), 0, 1); t0/t1_bracket are injected per cadence segment by the ESS runtime from the interpolate-mode ERA5 loader's bracket timestamps."
    }
  ]
}
